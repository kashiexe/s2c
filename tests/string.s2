/*
    This file tests the string type as well as parametered functions and inline assembly.
*/

fun print(s: string) -> i32 {
    @mov(rax, 1)
    @mov(rdi, 1)
    @mov(rsi, s)
    @mov(rdx, s.length)
    @syscall()
    return 0
}

fun main(argc: i32, argv: string*) -> i32 {
    let c = "hello world";
    print(c)
    return 0
}